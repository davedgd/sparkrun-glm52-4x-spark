# Date-pinned Spark Arena eugr nightly close to the local-inference-lab
# 2026-06-22 DCP/shard-draft vLLM branch used below.
ARG BASE_IMAGE=ghcr.io/spark-arena/dgx-vllm-eugr-nightly:20260622
FROM ${BASE_IMAGE}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Zatz/tonyd2wild's recipe expects a stock eugr dev-era vLLM image:
# aarch64, CUDA 13, vLLM 0.23.1rc1.dev-era.
RUN python3 - <<'PY'
import platform
import torch
import vllm

assert platform.machine() in {"aarch64", "arm64"}, platform.machine()
assert torch.version.cuda and torch.version.cuda.startswith("13."), torch.version.cuda
assert vllm.__version__.startswith("0.23.1rc1.dev"), vllm.__version__
print("base vllm:", vllm.__version__)
PY

WORKDIR /opt/src

# Overlay the local-inference-lab fork's pure-Python vLLM tree onto installed vLLM.
# This intentionally does not rebuild vLLM. Copying every vllm/**/*.py avoids
# guessing the right diff base for the eugr dev image while preserving native libs.
ARG VLLM_REF=codex/dcp-globaltopk-sharddraft-defaults-20260622
RUN git clone --filter=blob:none https://github.com/local-inference-lab/vllm.git \
    && VLLM_SITE="$(python3 -c 'import os, vllm; print(os.path.dirname(vllm.__file__))')" \
    && cd vllm \
    && git checkout "${VLLM_REF}" \
    && find vllm -type f -name '*.py' > /tmp/vllm-python-overlay \
    && while IFS= read -r src; do \
            dst="${VLLM_SITE}/${src#vllm/}"; \
            mkdir -p "$(dirname "${dst}")"; \
            cp "${src}" "${dst}"; \
        done < /tmp/vllm-python-overlay \
    && python3 -m compileall -q "${VLLM_SITE}" \
    && rm -f /tmp/vllm-python-overlay \
    && rm -rf /opt/src/vllm

# Install the b12x fork containing the GB10 sparse-MLA kernels.
RUN git clone https://github.com/voipmonitor/b12x.git \
    && cd b12x \
    && git checkout 9cd63a72 \
    && python3 -m pip install --no-deps --force-reinstall . \
    && cd /opt/src \
    && rm -rf b12x

# Apply tonyd2wild's GLM 5.2 runtime compatibility patchers.
ARG GLM_PATCHES_REF=b1cf983ccf0519e05b3369c78f46fd46debf4928
RUN git clone --filter=blob:none \
        https://github.com/tonyd2wild/GLM-5.2-655K-MTP-4x-DGX-Spark.git \
        /opt/glm52-patches \
    && cd /opt/glm52-patches \
    && git checkout "${GLM_PATCHES_REF}" \
    && python3 patches/fix-mtp-draft-fused-qkv-mapping.py \
    && python3 patches/fix-mla-int32-chunked-prefill.py \
    && python3 patches/fix-dsa-indexer-block-table.py \
    && cd /opt/src \
    && rm -rf /opt/glm52-patches

WORKDIR /workspace

# Inherit the eugr/NVIDIA entrypoint; Sparkrun supplies the command.
CMD []
